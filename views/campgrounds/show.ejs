<% layout('layouts/boilerplate') %>
<link rel="stylesheet" href="/stylesheets/star.css" />
<div class="row g-4 flex-column flex-md-row">
  <div class="col-12 col-md-6">
    <div class="card h-100 position-relative overflow-hidden">
      <div class="position-relative">
        <img
          src="<%= campground.image %>"
          class="card-img-top img-fluid"
          alt="PetCamp img"
          style="object-fit: cover; max-height: 350px"
        />
        <h1
          class="position-absolute top-50 start-50 translate-middle text-center fw-bold display-3"
          style="
            color: #fff;
            text-shadow: 2px 2px 12px rgba(0, 0, 0, 0.7), 0 0 8px #2d8659;
            letter-spacing: 2px;
            width: 100%;
          "
        >
          <%=campground.title%>
        </h1>
      </div>
      <div class="card-body mt-2">
        <h3 class="card-title"><%=campground.title%></h3>
        <h5>Price: <%=campground.price%></h5>
        <h5>Location: <%=campground.location%></h5>
        <h6 class="text-muted">
          Submitted by: <%=campground.author.username%>
        </h6>
        <p class="card-text"><%=campground.description%></p>
      </div>
      <% if(currentUser && campground.author._id.toString() ===
      currentUser._id.toString()){%>
      <div class="container mb-3">
        <div class="row">
          <div class="col d-grid">
            <a
              href="/campgrounds/<%=campground._id%>/edit"
              class="btn btn-primary"
              type="button"
              >Edit PetCamp</a
            >
          </div>
          <div class="col">
            <form
              class="d-grid"
              action="/campgrounds/<%=campground._id%>?_method=DELETE"
              method="post"
            >
              <button class="btn btn-danger" type="submit">
                Delete PetCamp
              </button>
            </form>
          </div>
        </div>
      </div>
      <%}%>
      <div class="d-grid mb-3 px-3">
        <a href="/campgrounds" class="btn btn-secondary">Go back</a>
      </div>
    </div>
  </div>
  <div class="col-12 col-md-6">
    <% if(currentUser){%>
    <h2>Leave a review</h2>
    <form
      action="/campgrounds/<%=campground._id%>/reviews"
      method="post"
      class="mb-3 needs-validation"
      novalidate
    >
      <div class="mb-3">

        <div class="d-flex align-items-center gap-2">
          <fieldset class="starability-basic">
            <input
              type="radio"
              id="no-rate"
              class="input-no-rate"
              name="review[rating]"
              value="1"
              checked
              aria-label="No rating."
            />
            <input
              type="radio"
              id="first-rate1"
              name="review[rating]"
              value="1"
            />
            <label for="first-rate1" title="Terrible">1 star</label>
            <input
              type="radio"
              id="first-rate2"
              name="review[rating]"
              value="2"
            />
            <label for="first-rate2" title="Not good">2 stars</label>
            <input
              type="radio"
              id="first-rate3"
              name="review[rating]"
              value="3"
            />
            <label for="first-rate3" title="Average">3 stars</label>
            <input
              type="radio"
              id="first-rate4"
              name="review[rating]"
              value="4"
            />
            <label for="first-rate4" title="Very good">4 stars</label>
            <input
              type="radio"
              id="first-rate5"
              name="review[rating]"
              value="5"
            />
            <label for="first-rate5" title="Amazing">5 stars</label>
          </fieldset>
        </div>
      </div>
      <div class="mb-3">
        <label class="form-label" for="reviewBody">Review </label>
        <textarea
          class="form-control"
          name="review[body]"
          id="reviewBody"
          cols="30"
          rows="3"
          required
        ></textarea>
        <div class="valid-feedback">Looks good!</div>
      </div>
      <button class="btn btn-success">Add a review</button>
    </form>
    <%}%>
    <h2>Reviews</h2>
    <%if(campground.reviews.length >= 1){for(let review of
    campground.reviews){%>
    <div class="card mb-3">
      <div class="card-body">
        <%if(review.author && review.author.username){%>
        <h4 class="card-title"><%= review.author.username%></h4>
        <%}%>
        <p class="starability-result" data-rating="<%=review.rating%>">
          Rated: <%=review.rating%> stars
        </p>
        <p><%= review.body%></p>
        <% if(currentUser && review.author && review.author._id.toString() ===
        currentUser._id.toString()){%>
        <form
          action="/campgrounds/<%=campground._id%>/reviews/<%=review._id%>?_method=DELETE"
          method="post"
        >
          <button class="btn btn-danger btn-sm">Delete</button>
        </form>
        <%}%>
      </div>
    </div>
    <%}}%>
  </div>
</div>
